# Conexión de la aplicación (rol erp_app: sin DELETE en tablas financieras ni DDL)
DATABASE_URL=postgres://erp_app:CAMBIAR@localhost:5432/erp
# Conexión para migraciones (rol erp_owner, dueño del esquema)
DATABASE_OWNER_URL=postgres://erp_owner:CAMBIAR@localhost:5432/erp
# Conexión de solo lectura para pg_dump (rol erp_backup)
DATABASE_BACKUP_URL=postgres://erp_backup:CAMBIAR@localhost:5432/erp
# Superusuario: solo lo usan bootstrap, la verificación y la restauración de backups (consola)
DATABASE_ADMIN_URL=postgres://postgres:CAMBIAR@localhost:5432/postgres
# Solo para pruebas automáticas: superusuario que crea y borra la base de pruebas
TEST_ADMIN_URL=postgres://postgres:CAMBIAR@localhost:5432/postgres
# Zona horaria fija del sistema
TZ=America/Argentina/Buenos_Aires
# Habilita la carga de datos de demostración (nunca en producción)
ALLOW_DEMO_SEED=false
# Backups (sección J del diseño; ver docs/runbooks/backup-y-restauracion.md)
BACKUP_DIR=/var/backups/erp
# Copia fuera del servidor: carpeta de un NAS o de un almacenamiento S3 montado (rclone/s3fs). Vacío = sin copia externa.
BACKUP_OFFSITE_DIR=
# Clave PÚBLICA de age para cifrar la copia externa (la privada se guarda fuera del servidor)
BACKUP_AGE_RECIPIENT=
# Retención: últimos N diarios, semanales y mensuales
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# Opcional: carpeta de pg_dump/pg_restore si no están en el PATH (deben ser de la misma versión mayor que el servidor)
PG_BIN_DIR=
# Opcional: archivo que pone la aplicación en mantenimiento durante una restauración (por defecto ./.maintenance)
MAINTENANCE_FILE=
