# Conexión de la aplicación (rol erp_app: sin DELETE en tablas financieras ni DDL)
DATABASE_URL=postgres://erp_app:CAMBIAR@localhost:5432/erp
# Conexión para migraciones (rol erp_owner, dueño del esquema)
DATABASE_OWNER_URL=postgres://erp_owner:CAMBIAR@localhost:5432/erp
# Solo para pruebas automáticas: superusuario que crea y borra la base de pruebas
TEST_ADMIN_URL=postgres://postgres:CAMBIAR@localhost:5432/postgres
# Zona horaria fija del sistema
TZ=America/Argentina/Buenos_Aires
# Habilita la carga de datos de demostración (nunca en producción)
ALLOW_DEMO_SEED=false
