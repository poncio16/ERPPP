# .env de producción con Docker (compose.produccion.yml). Lo genera deploy/generar-env.sh con claves
# aleatorias; este archivo es solo la plantilla. Nunca subir el .env al repositorio.
COMPOSE_FILE=compose.produccion.yml

# Dominio con el que se entra al ERP (registro DNS A apuntando a la IP del servidor)
ERP_DOMAIN=__DOMINIO__

# Superusuario de PostgreSQL (lo usan el contenedor db, bootstrap, la verificación y la restauración)
POSTGRES_PASSWORD=__CLAVE_POSTGRES__
DATABASE_ADMIN_URL=postgres://postgres:__CLAVE_POSTGRES__@db:5432/postgres
# Aplicación (rol erp_app: sin DELETE en tablas financieras ni DDL)
DATABASE_URL=postgres://erp_app:__CLAVE_APP__@db:5432/erp
# Migraciones (rol erp_owner, dueño del esquema)
DATABASE_OWNER_URL=postgres://erp_owner:__CLAVE_OWNER__@db:5432/erp
# pg_dump de solo lectura (rol erp_backup)
DATABASE_BACKUP_URL=postgres://erp_backup:__CLAVE_BACKUP__@db:5432/erp

TZ=America/Argentina/Buenos_Aires
ALLOW_DEMO_SEED=false

# Backups (docs/runbooks/backup-y-restauracion.md). Carpetas del SERVIDOR; adentro del contenedor
# se ven como /var/backups/erp y /var/backups/erp-externo.
BACKUP_HOST_DIR=/var/backups/erp
# Carpeta montada de un NAS o de un bucket S3 (rclone mount). Vacío = sin copia externa (la pantalla Backups lo marca).
BACKUP_OFFSITE_HOST_DIR=
# Clave PÚBLICA de age (age1...). La privada se guarda fuera del servidor.
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
