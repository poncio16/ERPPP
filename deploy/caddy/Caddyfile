# Proxy HTTPS del ERP. Caddy obtiene y renueva solo el certificado de Let's Encrypt para ERP_DOMAIN
# (el dominio tiene que apuntar a este servidor y los puertos 80 y 443 tienen que estar abiertos).
# Caddy descarta los X-Forwarded-For que mande el navegador y pone la IP real del cliente, que es la
# que usan la auditoría y el límite de intentos de ingreso.
{$ERP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}
